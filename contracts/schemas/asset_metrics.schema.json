{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-masterplan.local/schemas/asset_metrics.schema.json",
  "title": "asset_metrics.csv",
  "description": "Row schema for asset_metrics.csv. Empty cells are NaN under pandas; validators must treat NaN as null. The five *_score columns are retained for CSV alignment only and carry no meaning as of v0.4.0.",
  "type": "object",
  "required": ["asset_id", "year", "metric_source", "model_version"],
  "properties": {
    "asset_id": { "type": "string" },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },
    "subtype": {
      "type": ["string", "null"],
      "$comment": "Present for commercial, community_facility, residential, undeveloped_parcel. Absent (null) for green_space in current B3 output."
    },

    "occupancy_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "vacancy_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "vacancy_duration_months": { "type": ["number", "null"], "minimum": 0 },
    "footfall_daily": { "type": ["number", "null"], "minimum": 0 },
    "rental_income_per_visit_proxy": { "type": ["number", "null"] },
    "utilisation_rate": { "type": ["number", "null"], "minimum": 0 },

    "rental_income_rm": { "type": ["number", "null"] },
    "noi_rm": { "type": ["number", "null"] },
    "noi_yield": { "type": ["number", "null"] },
    "maintenance_surge_rm": { "type": ["number", "null"] },

    "accessibility_score": {
      "type": ["number", "null"], "minimum": 0, "maximum": 100,
      "$comment": "Deprecated bridge metric. Retained during the Phase 4 transition. New code should read coverage_ratio_*_walk / coverage_ratio_*_drive instead."
    },

    "catchment_population_5min_walk": { "type": ["number", "null"] },
    "catchment_population_10min_walk": { "type": ["number", "null"] },
    "catchment_population_15min_walk": { "type": ["number", "null"] },
    "coverage_ratio_5min_walk": { "type": ["number", "null"] },
    "coverage_ratio_10min_walk": { "type": ["number", "null"] },
    "coverage_ratio_15min_walk": { "type": ["number", "null"] },
    "mean_walk_distance_m": { "type": ["number", "null"] },
    "median_walk_distance_m": { "type": ["number", "null"] },
    "p90_walk_distance_m": { "type": ["number", "null"] },
    "reachable_population_walk": { "type": ["number", "null"] },
    "total_catchment_population": { "type": ["number", "null"] },

    "catchment_population_5min_drive": { "type": ["number", "null"] },
    "catchment_population_10min_drive": { "type": ["number", "null"] },
    "catchment_population_15min_drive": { "type": ["number", "null"] },
    "coverage_ratio_5min_drive": { "type": ["number", "null"] },
    "coverage_ratio_10min_drive": { "type": ["number", "null"] },
    "coverage_ratio_15min_drive": { "type": ["number", "null"] },
    "mean_drive_distance_m": { "type": ["number", "null"] },
    "median_drive_distance_m": { "type": ["number", "null"] },
    "p90_drive_distance_m": { "type": ["number", "null"] },
    "reachable_population_drive": { "type": ["number", "null"] },

    "service_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "cost_per_user_rm": { "type": ["number", "null"] },

    "effective_demand": { "type": ["number", "null"] },
    "effective_demand_m2": { "type": ["number", "null"] },
    "effective_supply": { "type": ["number", "null"] },
    "dsr": { "type": ["number", "null"] },

    "carbon_operational_tco2e": { "type": ["number", "null"] },
    "energy_kwh": { "type": ["number", "null"] },

    "green_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "canopy_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "shade_proxy_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "green_per_capita_m2": { "type": ["number", "null"] },

    "developable_area_m2": { "type": ["number", "null"] },
    "potential_gfa_m2": { "type": ["number", "null"] },
    "demand_supply_gap": { "type": ["number", "null"] },
    "infrastructure_cost_rm": { "type": ["number", "null"] },

    "energy_intensity_kwh_m2": { "type": ["number", "null"] },

    "demographic_mismatch": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "neighborhood_diversity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },

    "energy_kwh_hvac": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — HVAC sub-system energy."
    },
    "energy_kwh_lighting_equipment": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — lighting and tenant equipment energy."
    },
    "energy_kwh_base_load": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — base load (elevators, pumps, standby)."
    },
    "carbon_productive_tco2e": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — operational carbon proportional to occupancy/utilisation."
    },
    "carbon_stranded_tco2e": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — operational carbon wasted on unused capacity."
    },
    "stranded_carbon_ratio": {
      "type": ["number", "null"], "minimum": 0, "maximum": 1
    },
    "embodied_carbon_total_tco2e": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — life-cycle carbon locked into the structure."
    },
    "embodied_carbon_amortised_tco2e": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — annual amortised share of embodied carbon."
    },
    "maintenance_carbon_tco2e": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — annual carbon from maintenance activities."
    },
    "surface_temp_delta_c": {
      "type": ["number", "null"],
      "$comment": "Phase 11 — UHI proxy. Positive = warmer, negative = cooler."
    },

    "financial_score":     { "type": ["number", "null"], "deprecated": true, "$comment": "Removed in v0.4.0. Kept for CSV column alignment. Do not consume." },
    "environmental_score": { "type": ["number", "null"], "deprecated": true, "$comment": "Removed in v0.4.0." },
    "social_score":        { "type": ["number", "null"], "deprecated": true, "$comment": "Removed in v0.4.0." },
    "performance_score":   { "type": ["number", "null"], "deprecated": true, "$comment": "Removed in v0.4.0." },
    "delta_score":         { "type": ["number", "null"], "deprecated": true, "$comment": "Removed in v0.4.0." },

    "metric_source": { "enum": ["observed", "derived", "assumed", "simulated"] },
    "model_version": { "type": "string" }
  }
}