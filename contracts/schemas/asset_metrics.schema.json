{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-masterplan.local/schemas/asset_metrics.schema.json",
  "title": "asset_metrics.csv",
  "description": "Time-series schema for asset_metrics.csv — one row per asset per year. B3/B4/B5 write here.",
  "type": "object",
  "required": ["asset_id", "year", "metric_source", "model_version"],
  "properties": {
    "asset_id": { "type": "string" },
    "year": { "type": "integer", "minimum": 2000, "maximum": 2100 },

    "occupancy_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "vacancy_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "vacancy_duration_months": { "type": ["number", "null"], "minimum": 0 },
    "footfall_daily": { "type": ["number", "null"], "minimum": 0 },
    "utilisation_rate": { "type": ["number", "null"], "minimum": 0 },

    "rental_income_rm": { "type": ["number", "null"] },
    "noi_rm": { "type": ["number", "null"] },
    "noi_yield": { "type": ["number", "null"] },

    "accessibility_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "service_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },

    "effective_demand": { "type": ["number", "null"] },
    "effective_supply": { "type": ["number", "null"] },
    "dsr": { "type": ["number", "null"] },

    "carbon_operational_tco2e": { "type": ["number", "null"] },
    "energy_kwh": { "type": ["number", "null"] },

    "green_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "canopy_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "thermal_exposure": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },

    "financial_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "environmental_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "social_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "performance_score": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
    "delta_score": { "type": ["number", "null"] },

    "metric_source": {
      "enum": ["observed", "derived", "assumed", "simulated"]
    },
    "model_version": { "type": "string" }
  }
}