{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-masterplan.local/schemas/development_candidates.schema.json",
  "title": "development_candidates.csv",
  "description": "Pre-defined development options for undeveloped parcels. The LLM picks from this list. development_type is a taxonomy subtype key, not a high-level category — the same key space used by interventions.parameters.to_subtype.",
  "type": "object",
  "required": [
    "candidate_id", "parcel_id", "development_type", "expected_capex_rm",
    "expected_completion_year", "expected_utilisation", "feasibility_status"
  ],
  "properties": {
    "candidate_id": { "type": "string", "pattern": "^CAND-" },
    "parcel_id": { "type": "string", "pattern": "^P-" },
    "development_type": {
      "type": "string",
      "$comment": "Must be a key in taxonomy.yml subtypes. Call get_available_subtypes via the LLM tool layer to enumerate.",
      "enum": [
        "convenience_retail", "supermarket", "f_and_b", "medical_retail",
        "office", "services", "entertainment", "showroom",
        "clinic", "community_hall", "library", "childcare", "school",
        "sports_centre", "place_of_worship", "public_service",
        "terrace", "semidetached", "detached",
        "apartment_lowrise", "apartment_highrise", "affordable_housing",
        "park", "pocket_park", "green_corridor", "sports_field", "water_body",
        "vacant"
      ]
    },
    "target_gfa_m2": { "type": ["number", "null"] },
    "target_units": { "type": ["integer", "null"] },
    "target_demographic": { "type": ["string", "null"] },
    "expected_capex_rm": { "type": "number", "minimum": 0 },
    "expected_completion_year": { "type": "integer" },
    "expected_demand_coverage": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "expected_utilisation": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "expected_carbon_tco2e": { "type": ["number", "null"] },
    "expected_accessibility_delta": { "type": ["number", "null"] },
    "feasibility_status": { "enum": ["feasible", "infeasible", "constraint_flagged"] },
    "constraint_notes": { "type": ["string", "null"] }
  }
}