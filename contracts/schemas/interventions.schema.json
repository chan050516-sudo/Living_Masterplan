{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-masterplan.local/schemas/interventions.schema.json",
  "title": "interventions.csv",
  "description": "v1.1 EXTENDED. One row per intervention per scenario. Includes time anchors and expected vs simulated validation.",
  "type": "object",
  "required": [
    "scenario_id", "intervention_id", "target_asset_id", "intervention_type",
    "parameters_json", "construction_start_year", "construction_duration_months",
    "activation_year", "validation_status", "status"
  ],
  "properties": {
    "scenario_id": { "type": "string", "pattern": "^SC-" },
    "intervention_id": { "type": "string", "pattern": "^INT-" },
    "target_asset_id": { "type": "string" },
    "intervention_type": {
      "enum": ["repurpose", "retrofit", "green_corridor",
               "pedestrian_upgrade", "new_development", "delay_development"]
    },
    "parameters_json": {
      "type": "string",
      "description": "JSON-encoded intervention parameters",
      "examples": ["{\"from\":\"commercial\",\"to\":\"community_facility\"}"]
    },
    "expected_derived_json": {
      "type": ["string", "null"],
      "description": "LLM-expected derived metrics (JSON string). Tier 3."
    },
    "expected_source": { "type": ["string", "null"], "enum": ["llm_estimate", null] },
    "construction_start_year": { "type": "integer" },
    "construction_duration_months": { "type": "integer", "minimum": 0 },
    "activation_year": { "type": "integer" },
    "during_construction_status": {
      "enum": ["unavailable", "partial", "operational"]
    },
    "capex_delta_rm": { "type": ["number", "null"] },
    "opex_delta_rm": { "type": ["number", "null"] },
    "validation_status": { "enum": ["pending", "validated", "corrected", "rejected"] },
    "status": { "enum": ["proposed", "simulated", "applied", "discarded"] }
  }
}