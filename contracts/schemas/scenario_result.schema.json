{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://living-masterplan.local/schemas/scenario_result.schema.json",
  "title": "ScenarioResult",
  "description": "Output of B4. Multi-year simulation results + comparison + map diff.",
  "type": "object",
  "required": ["scenario_id", "scenario_name", "interventions", "years", "comparison", "map_diff", "model_version"],
  "properties": {
    "scenario_id": { "type": "string", "pattern": "^SC-" },
    "scenario_name": { "type": "string" },
    "interventions": { "type": "array" },
    "years": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "assets": { "type": "object" },
          "scores": { "type": "object" }
        }
      }
    },
    "comparison": {
      "type": "object",
      "required": ["focus_asset_id", "metrics", "township_metrics"],
      "properties": {
        "focus_asset_id": { "type": ["string", "null"] },
        "metrics": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["before", "after", "unit"],
            "properties": {
              "before": { "type": ["number", "null"] },
              "after": { "type": ["number", "null"] },
              "unit": { "type": "string" }
            }
          }
        },
        "township_metrics": {
          "type": "object",
          "properties": {
            "walk_15min_avg_coverage_before": { "type": ["number", "null"] },
            "walk_15min_avg_coverage_after": { "type": ["number", "null"] },
            "walk_15min_coverage_delta": { "type": ["number", "null"] },
            "total_carbon_before_tco2e": { "type": ["number", "null"] },
            "total_carbon_after_tco2e": { "type": ["number", "null"] },
            "carbon_delta_pct": { "type": ["number", "null"] }
          }
        }
      }
    },
    "map_diff": {
      "type": "object",
      "required": ["changed_assets", "spillover_assets", "negative_assets"],
      "properties": {
        "changed_assets": { "type": "array" },
        "spillover_assets": { "type": "array" },
        "negative_assets": { "type": "array" }
      }
    },
    "model_version": { "type": "string" }
  }
}